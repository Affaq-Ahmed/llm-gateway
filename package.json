{
  "name": "@affaqahmed/llm-gateway",
  "version": "0.0.0",
  "description": "Provider-neutral LLM gateway for Anthropic, OpenAI, and OpenRouter: normalized streaming, structured outputs, retries, failover with an explicit stream commit point, and cache-aware cost telemetry.",
  "keywords": [
    "llm",
    "gateway",
    "anthropic",
    "openai",
    "openrouter",
    "streaming",
    "failover",
    "circuit-breaker",
    "structured-output",
    "prompt-caching"
  ],
  "author": "Affaq Ahmed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Affaq-Ahmed/llm-gateway.git"
  },
  "homepage": "https://github.com/Affaq-Ahmed/llm-gateway#readme",
  "bugs": {
    "url": "https://github.com/Affaq-Ahmed/llm-gateway/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && node --test scripts/record.test.mjs",
    "typecheck": "tsc --noEmit",
    "capture:live": "npm run build --silent && node --env-file=../week2-scratch/.env scripts/capture-live.mjs",
    "demo:failover": "npm run build --silent && node scripts/demo-failover.mjs",
    "demo:gif": "npm run demo:failover --silent -- --transcript docs/assets/failover-demo.txt && node scripts/render-demo-gif.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "openai": "^7.25.0",
    "zod": "^4.6.5"
  }
}
